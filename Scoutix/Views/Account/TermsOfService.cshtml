@{
    ViewData["Title"] = "Terms of Service — Scoutix";
    Layout = "_VisitorLayout";
}

<style>
    :root {
        --primary: #059669;
        --accent: #F59E0B;
        --dark: #064E3B;
        --light-green: #ECFDF5;
        --gold-light: #FEF3C7;
        --text: #1C1917;
        --text-muted: #6B7280;
        --border: #D1FAE5
    }

    .page-hero {
        background: linear-gradient(135deg, #78350F 0%, #92400E 40%, #B45309 100%);
        padding: 80px 60px 100px;
        position: relative;
        overflow: hidden
    }

        .page-hero::before {
            content: '';
            position: absolute;
            top: -40%;
            right: -10%;
            width: 500px;
            height: 500px;
            background: radial-gradient(circle, rgba(245,158,11,0.2) 0%, transparent 60%)
        }

        .page-hero::after {
            content: '';
            position: absolute;
            bottom: 0;
            left: 0;
            width: 400px;
            height: 300px;
            background: radial-gradient(circle at bottom left, rgba(6,78,59,0.4) 0%, transparent 70%)
        }

    .hero-inner {
        max-width: 900px;
        margin: 0 auto;
        position: relative;
        z-index: 1
    }

    .page-badge {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        background: rgba(5,150,105,0.2);
        border: 1px solid rgba(5,150,105,0.4);
        color: #6EE7B7;
        padding: 6px 16px;
        border-radius: 50px;
        font-size: 12px;
        font-weight: 600;
        letter-spacing: .08em;
        text-transform: uppercase;
        margin-bottom: 24px
    }

    .page-hero h1 {
        font-family: 'Playfair Display', serif;
        font-size: clamp(36px, 5vw, 56px);
        color: #fff;
        font-weight: 700;
        line-height: 1.15;
        margin-bottom: 20px
    }

        .page-hero h1 em {
            font-style: normal;
            color: #FDE68A
        }

    .page-hero p {
        font-size: 17px;
        color: rgba(255,255,255,0.7);
        max-width: 600px;
        margin-bottom: 36px
    }

    .meta-row {
        display: flex;
        gap: 30px;
        flex-wrap: wrap
    }

    .meta-item {
        display: flex;
        align-items: center;
        gap: 8px;
        color: rgba(255,255,255,0.6);
        font-size: 13px
    }

        .meta-item .dot {
            width: 6px;
            height: 6px;
            background: #FDE68A;
            border-radius: 50%
        }

    .content-wrapper {
        max-width: 1100px;
        margin: 0 auto;
        padding: 60px 60px 100px;
        display: grid;
        grid-template-columns: 260px 1fr;
        gap: 60px;
        align-items: start
    }

    .sidebar {
        position: sticky;
        top: 80px
    }

    .sidebar-card {
        background: #fff;
        border: 1px solid var(--border);
        border-radius: 16px;
        padding: 28px;
        box-shadow: 0 4px 24px rgba(5,150,105,0.06)
    }

    .sidebar-title {
        font-size: 11px;
        font-weight: 600;
        letter-spacing: .1em;
        text-transform: uppercase;
        color: var(--text-muted);
        margin-bottom: 16px
    }

    .toc-list {
        list-style: none;
        display: flex;
        flex-direction: column;
        gap: 4px;
        padding: 0;
        margin: 0
    }

        .toc-list a {
            text-decoration: none;
            color: var(--text-muted);
            font-size: 13px;
            padding: 7px 12px;
            border-radius: 8px;
            display: block;
            transition: all .2s;
            border-left: 2px solid transparent
        }

            .toc-list a:hover {
                color: var(--primary);
                background: var(--light-green);
                border-left-color: var(--primary);
                padding-left: 16px
            }

    .sidebar-warning {
        margin-top: 20px;
        padding: 16px;
        background: var(--gold-light);
        border-radius: 10px;
        border: 1px solid rgba(245,158,11,0.3)
    }

        .sidebar-warning p {
            font-size: 12.5px;
            color: #78350F;
            line-height: 1.6;
            margin: 0
        }

    .main-content {
        min-width: 0
    }

    .intro-card {
        background: var(--gold-light);
        border: 1px solid rgba(245,158,11,0.3);
        border-radius: 16px;
        padding: 28px 32px;
        margin-bottom: 48px;
        display: flex;
        gap: 16px;
        align-items: flex-start
    }

    .intro-card-icon {
        font-size: 24px;
        flex-shrink: 0
    }

    .intro-card p {
        font-size: 15px;
        color: #78350F;
        line-height: 1.7;
        margin: 0
    }

        .intro-card p strong {
            color: #92400E
        }

    .info-box {
        background: #EFF6FF;
        border-left: 4px solid #3B82F6;
        border-radius: 0 12px 12px 0;
        padding: 20px 24px;
        margin: 24px 0;
        font-size: 15px;
        color: #1E3A5F;
        line-height: 1.8
    }

    section.policy-section {
        margin-bottom: 56px;
        scroll-margin-top: 100px
    }

    .section-number {
        font-size: 12px;
        font-weight: 600;
        color: var(--accent);
        text-transform: uppercase;
        letter-spacing: .1em;
        margin-bottom: 8px
    }

    .policy-section h2 {
        font-family: 'Playfair Display', serif;
        font-size: 26px;
        font-weight: 700;
        color: var(--dark);
        margin-bottom: 20px;
        padding-bottom: 16px;
        border-bottom: 2px solid var(--border)
    }

    .policy-section p {
        font-size: 15.5px;
        color: #374151;
        margin-bottom: 16px;
        line-height: 1.85
    }

    .policy-section h3 {
        font-family: 'Playfair Display', serif;
        font-size: 18px;
        color: var(--dark);
        margin: 28px 0 12px;
        font-weight: 600
    }

    .highlight-box {
        background: var(--light-green);
        border-left: 4px solid var(--primary);
        border-radius: 0 12px 12px 0;
        padding: 20px 24px;
        margin: 24px 0;
        font-size: 15px;
        color: #065F46;
        line-height: 1.8
    }

    .warning-box {
        background: #FEF2F2;
        border-left: 4px solid #EF4444;
        border-radius: 0 12px 12px 0;
        padding: 20px 24px;
        margin: 24px 0;
        font-size: 15px;
        color: #7F1D1D;
        line-height: 1.8
    }

    .terms-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 16px;
        margin: 20px 0
    }

    .term-card {
        background: #fff;
        border: 1px solid var(--border);
        border-radius: 12px;
        padding: 20px
    }

        .term-card.allowed {
            border-top: 3px solid var(--primary)
        }

        .term-card.prohibited {
            border-top: 3px solid #EF4444
        }

        .term-card h4 {
            font-size: 13px;
            font-weight: 600;
            margin-bottom: 12px;
            display: flex;
            align-items: center;
            gap: 8px
        }

        .term-card.allowed h4 {
            color: var(--primary)
        }

        .term-card.prohibited h4 {
            color: #DC2626
        }

        .term-card ul {
            list-style: none;
            font-size: 13.5px;
            color: var(--text-muted);
            line-height: 1.9;
            padding: 0;
            margin: 0
        }

        .term-card.allowed ul li::before {
            content: '✓';
            color: var(--primary);
            font-weight: 700;
            margin-right: 8px
        }

        .term-card.prohibited ul li::before {
            content: '✕';
            color: #DC2626;
            font-weight: 700;
            margin-right: 8px
        }

    .plan-table {
        width: 100%;
        border-collapse: collapse;
        margin: 20px 0;
        border-radius: 12px;
        overflow: hidden;
        box-shadow: 0 1px 12px rgba(5,150,105,0.08)
    }

        .plan-table thead tr {
            background: var(--dark);
            color: #fff
        }

        .plan-table th {
            padding: 14px 20px;
            text-align: left;
            font-size: 13px;
            font-weight: 500;
            letter-spacing: .03em
        }

        .plan-table tbody tr {
            border-bottom: 1px solid var(--border);
            background: #fff;
            transition: background .15s
        }

            .plan-table tbody tr:hover {
                background: var(--light-green)
            }

            .plan-table tbody tr:last-child {
                border-bottom: none
            }

        .plan-table td {
            padding: 14px 20px;
            font-size: 14px;
            color: #374151
        }

            .plan-table td:first-child {
                font-weight: 500;
                color: var(--dark)
            }

    .badge-green {
        display: inline-block;
        background: var(--light-green);
        color: var(--primary);
        padding: 2px 10px;
        border-radius: 50px;
        font-size: 12px;
        font-weight: 600
    }

    .contact-card {
        background: linear-gradient(135deg, #78350F, #92400E);
        border-radius: 16px;
        padding: 36px;
        color: #fff;
        margin-top: 20px;
        position: relative;
        overflow: hidden
    }

        .contact-card::before {
            content: '⚖';
            position: absolute;
            right: 30px;
            top: 20px;
            font-size: 80px;
            opacity: .08
        }

        .contact-card h3 {
            font-family: 'Playfair Display', serif;
            font-size: 22px;
            margin-bottom: 12px;
            color: #FDE68A
        }

        .contact-card p {
            color: rgba(255,255,255,0.7);
            font-size: 15px;
            margin-bottom: 20px
        }

    .contact-methods {
        display: flex;
        gap: 16px;
        flex-wrap: wrap
    }

    .contact-method {
        background: rgba(255,255,255,0.1);
        border: 1px solid rgba(255,255,255,0.2);
        border-radius: 10px;
        padding: 12px 18px;
        font-size: 14px;
        color: #fff;
        display: flex;
        align-items: center;
        gap: 8px
    }

        .contact-method span {
            color: #FDE68A
        }

    @@keyframes fadeUp {
        from {
            opacity: 0;
            transform: translateY(20px)
        }

        to {
            opacity: 1;
            transform: translateY(0)
        }
    }

    .hero-inner > * {
        animation: fadeUp .6s ease forwards;
        opacity: 0
    }

        .hero-inner > *:nth-child(1) {
            animation-delay: .1s
        }

        .hero-inner > *:nth-child(2) {
            animation-delay: .2s
        }

        .hero-inner > *:nth-child(3) {
            animation-delay: .3s
        }

        .hero-inner > *:nth-child(4) {
            animation-delay: .4s
        }

    @@media (max-width: 900px) {
        .content-wrapper {
            grid-template-columns: 1fr;
            padding: 40px 24px 80px
        }

        .sidebar {
            position: static
        }

        .page-hero {
            padding: 60px 24px 80px
        }

        .terms-grid {
            grid-template-columns: 1fr
        }
    }
</style>

