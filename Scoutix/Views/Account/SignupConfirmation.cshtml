@{
    Layout = "_VisitorLayout";
    ViewData["Title"] = "Verify Your Email";
}

<!-- Confirmation Section -->
<section class="auth-section">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-5 col-md-7">
                <div class="auth-card confirmation-card">

                    <!-- Animated Envelope Icon -->
                    <div class="confirmation-icon-wrap">
                        <div class="confirmation-icon-ring"></div>
                        <div class="confirmation-icon-ring ring-2"></div>
                        <div class="auth-icon confirmation-icon">
                            <i class="bi bi-envelope-check-fill"></i>
                        </div>
                    </div>

                    <!-- Heading -->
                    <div class="auth-header confirmation-header">
                        <h2 class="auth-title">Check your inbox</h2>
                        <p class="auth-description">
                            We've sent a verification link to<br>
                            <strong class="confirmation-email">@(TempData["Email"] ?? "your email address")</strong>
                        </p>
                    </div>

                    <!-- Steps -->
                    <div class="confirmation-steps">
                        <div class="confirmation-step">
                            <div class="step-badge">1</div>
                            <div class="step-content">
                                <span class="step-title">Open your email</span>
                                <span class="step-desc">Look for an email from <strong>hello@scoutix.io</strong></span>
                            </div>
                        </div>
                        <div class="step-connector"></div>
                        <div class="confirmation-step">
                            <div class="step-badge">2</div>
                            <div class="step-content">
                                <span class="step-title">Click the verification link</span>
                                <span class="step-desc">The link will activate your account instantly</span>
                            </div>
                        </div>
                        <div class="step-connector"></div>
                        <div class="confirmation-step">
                            <div class="step-badge">3</div>
                            <div class="step-content">
                                <span class="step-title">Choose Plan and Checkout</span>
                                <span class="step-desc">You'll be redirected to your dashboard</span>
                            </div>
                        </div>
                    </div>

                    <!-- Divider -->
                    <div class="auth-divider"><span>didn't receive it?</span></div>

                    <!-- Help Box -->
                    <div class="confirmation-help">
                        <div class="help-item">
                            <i class="bi bi-folder2-open"></i>
                            <span>Check your <strong>spam or junk</strong> folder — it sometimes ends up there</span>
                        </div>
                        <div class="help-item">
                            <i class="bi bi-clock-history"></i>
                            <span>It may take up to <strong>2–3 minutes</strong> to arrive</span>
                        </div>
                        <div class="help-item">
                            <i class="bi bi-envelope-at-fill"></i>
                            <span>Make sure <strong>@(TempData["Email"] ?? "your email")</strong> is correct</span>
                        </div>
                    </div>

                    <!-- Resend -->
                    <form id="resendForm" method="post" asp-action="ResendVerification" asp-controller="Account">
                        <input type="hidden" name="email" value="@TempData["Email"]" />
                        <input type="hidden" name="planId" value="@TempData["PlanId"]" />
                        <button type="submit" class="btn-auth-resend" id="resendBtn">
                            <i class="bi bi-arrow-clockwise me-2"></i>
                            Resend Verification Email
                        </button>
                    </form>

                    <div class="auth-alternative" style="margin-top: 1.25rem;">
                        Used the wrong email? <a asp-action="SignUp" asp-controller="Account">Sign up again</a>
                    </div>

                </div>

                <!-- Bottom Trust Row -->
                <div class="auth-features">
                    <div class="auth-feature-item">
                        <i class="bi bi-shield-lock-fill"></i>
                        <span>Secure &amp; encrypted</span>
                    </div>
                    <div class="auth-feature-item">
                        <i class="bi bi-check-circle-fill"></i>
                        <span>Link expires in 24 hours</span>
                    </div>
                    <div class="auth-feature-item">
                        <i class="bi bi-headset"></i>
                        <span>Need help? <a href="mailto:support@scoutix.io" style="color:#059669;font-weight:600;text-decoration:none;">Contact us</a></span>
                    </div>
                </div>

            </div>
        </div>
    </div>
</section>

<style>
    /* ── Confirmation-specific styles (extends auth.css) ── */

    .confirmation-card {
        text-align: center;
        padding-top: 2.5rem;
    }

    /* Pulsing ring animation behind icon */
    .confirmation-icon-wrap {
        position: relative;
        width: 72px;
        height: 72px;
        margin: 0 auto 1.75rem;
    }

    .confirmation-icon-ring {
        position: absolute;
        inset: -12px;
        border-radius: 50%;
        border: 2px solid rgba(5, 150, 105, 0.25);
        animation: ringPulse 2.4s ease-out infinite;
    }

    .ring-2 {
        inset: -24px;
        border-color: rgba(5, 150, 105, 0.12);
        animation-delay: 0.6s;
    }

    @@keyframes ringPulse {
        0% {
            transform: scale(0.85);
            opacity: 0;
        }

        40% {
            opacity: 1;
        }

        100% {
            transform: scale(1.15);
            opacity: 0;
        }
    }

    .confirmation-icon {
        position: relative;
        z-index: 1;
        animation: iconPop 0.5s cubic-bezier(0.175, 0.885, 0.32, 1.275) both;
    }

    @@keyframes iconPop {
        from {
            transform: scale(0.5);
            opacity: 0;
        }

        to {
            transform: scale(1);
            opacity: 1;
        }
    }

    .confirmation-header {
        margin-bottom: 2rem;
    }

    .confirmation-email {
        color: #059669;
        font-weight: 700;
        font-size: 1rem;
        word-break: break-word;
    }

    /* Steps */
    .confirmation-steps {
        text-align: left;
        margin-bottom: 1.75rem;
    }

    .confirmation-step {
        display: flex;
        align-items: flex-start;
        gap: 1rem;
    }

    .step-badge {
        width: 32px;
        height: 32px;
        border-radius: 50%;
        background: linear-gradient(135deg, #059669, #047857);
        color: white;
        font-size: 0.8rem;
        font-weight: 700;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        box-shadow: 0 4px 10px rgba(5, 150, 105, 0.3);
    }

    .step-content {
        display: flex;
        flex-direction: column;
        padding-top: 0.35rem;
    }

    .step-title {
        font-size: 0.95rem;
        font-weight: 700;
        color: #1A1A1A;
        line-height: 1.3;
    }

    .step-desc {
        font-size: 0.85rem;
        color: #6B7280;
        margin-top: 0.2rem;
    }

    .step-connector {
        width: 2px;
        height: 22px;
        background: linear-gradient(to bottom, #059669, #D1FAE5);
        margin-left: 15px;
        border-radius: 2px;
    }

    /* Help items */
    .confirmation-help {
        background: #F0FDF4;
        border: 1px solid rgba(5, 150, 105, 0.15);
        border-radius: 12px;
        padding: 1.25rem 1.5rem;
        margin-bottom: 1.5rem;
        text-align: left;
        display: flex;
        flex-direction: column;
        gap: 0.875rem;
    }

    .help-item {
        display: flex;
        align-items: flex-start;
        gap: 0.75rem;
        font-size: 0.9rem;
        color: #374151;
    }

        .help-item i {
            color: #059669;
            font-size: 1rem;
            margin-top: 0.1rem;
            flex-shrink: 0;
        }

    /* Resend button */
    .btn-auth-resend {
        width: 100%;
        background: white;
        color: #059669;
        border: 2px solid #059669;
        padding: 0.875rem 2rem;
        border-radius: 12px;
        font-weight: 600;
        font-size: 1rem;
        cursor: pointer;
        transition: all 0.3s ease;
        display: inline-flex;
        align-items: center;
        justify-content: center;
    }

        .btn-auth-resend:hover {
            background: #059669;
            color: white;
            transform: translateY(-2px);
            box-shadow: 0 8px 20px rgba(5, 150, 105, 0.25);
        }

        .btn-auth-resend:disabled {
            opacity: 0.6;
            cursor: not-allowed;
            transform: none;
            box-shadow: none;
        }

    /* Fade-in for the whole card */
    .confirmation-card {
        animation: cardFadeUp 0.5s ease both;
    }

    @@keyframes cardFadeUp {
        from {
            opacity: 0;
            transform: translateY(20px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }
</style>

<script>
    // Resend cooldown — prevents hammering the endpoint
    (function () {
        const btn = document.getElementById('resendBtn');
        const COOLDOWN = 60; // seconds

        // Check if a cooldown is already running from a previous resend
        const lastSent = parseInt(sessionStorage.getItem('resendSentAt') || '0', 10);
        const elapsed = Math.floor((Date.now() - lastSent) / 1000);
        if (lastSent && elapsed < COOLDOWN) {
            startCountdown(COOLDOWN - elapsed);
        }

        document.getElementById('resendForm').addEventListener('submit', function (e) {
            sessionStorage.setItem('resendSentAt', Date.now().toString());
            startCountdown(COOLDOWN);
        });

        function startCountdown(seconds) {
            btn.disabled = true;
            let remaining = seconds;

            const tick = () => {
                btn.innerHTML = `<i class="bi bi-clock me-2"></i> Resend in ${remaining}s`;
                if (remaining-- <= 0) {
                    btn.disabled = false;
                    btn.innerHTML = `<i class="bi bi-arrow-clockwise me-2"></i> Resend Verification Email`;
                    return;
                }
                setTimeout(tick, 1000);
            };
            tick();
        }
    })();
</script>
