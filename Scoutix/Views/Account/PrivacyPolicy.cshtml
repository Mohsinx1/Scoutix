@{
    ViewData["Title"] = "Privacy Policy — Scoutix";
    Layout = "_VisitorLayout";
}

    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;600;700&family=DM+Sans:wght@300;400;500&display=swap" rel="stylesheet">
    <style>
        :root {
            --primary: #059669;
            --accent: #F59E0B;
            --dark: #064E3B;
            --light-green: #ECFDF5;
            --gold-light: #FEF3C7;
            --text: #1C1917;
            --text-muted: #6B7280;
            --border: #D1FAE5;
        }

        *, *::before, *::after {
            box-sizing: border-box;
            margin: 0;
            padding: 0
        }

        body {
            font-family: 'DM Sans', sans-serif;
            background: #FAFAF9;
            color: var(--text);
            line-height: 1.8
        }

            body::before {
                content: '';
                position: fixed;
                top: 0;
                right: 0;
                width: 600px;
                height: 600px;
                background: radial-gradient(ellipse at top right, rgba(5,150,105,0.08) 0%, transparent 70%);
                pointer-events: none;
                z-index: 0
            }

        .topbar {
            background: var(--dark);
            padding: 14px 0;
            text-align: center;
            font-size: 13px;
            color: rgba(255,255,255,0.7);
            letter-spacing: .05em
        }

            .topbar span {
                color: var(--accent);
                font-weight: 500
            }

        nav {
            background: #fff;
            border-bottom: 1px solid var(--border);
            padding: 20px 60px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            position: sticky;
            top: 0;
            z-index: 100;
            box-shadow: 0 1px 20px rgba(5,150,105,0.06)
        }

        .logo {
            font-family: 'Playfair Display', serif;
            font-size: 24px;
            font-weight: 700;
            color: var(--dark);
            display: flex;
            align-items: center;
            gap: 10px;
            text-decoration: none
        }

        .logo-icon {
            width: 38px;
            height: 38px;
            background: linear-gradient(135deg, var(--accent), #D97706);
            border-radius: 9px;
            display: flex;
            align-items: center;
            justify-content: center;
            color: #fff;
            font-size: 20px
        }

        .nav-links {
            display: flex;
            gap: 30px;
            list-style: none
        }

            .nav-links a {
                text-decoration: none;
                color: var(--text-muted);
                font-size: 14px;
                font-weight: 500;
                transition: color .2s
            }

                .nav-links a:hover, .nav-links a.active {
                    color: var(--primary)
                }

        .nav-cta {
            background: var(--primary);
            color: #fff !important;
            padding: 10px 22px;
            border-radius: 8px;
            font-weight: 500 !important;
            transition: background .2s !important
        }

            .nav-cta:hover {
                background: var(--dark) !important
            }

        .page-hero {
            background: linear-gradient(135deg, var(--dark) 0%, #065F46 60%, #047857 100%);
            padding: 80px 60px 100px;
            position: relative;
            overflow: hidden
        }

            .page-hero::before {
                content: '';
                position: absolute;
                top: -50%;
                left: -20%;
                width: 500px;
                height: 500px;
                background: radial-gradient(circle, rgba(245,158,11,0.15) 0%, transparent 60%)
            }

            .page-hero::after {
                content: '';
                position: absolute;
                bottom: -20px;
                right: -20px;
                width: 300px;
                height: 300px;
                background: radial-gradient(circle, rgba(5,150,105,0.3) 0%, transparent 70%)
            }

        .hero-inner {
            max-width: 900px;
            margin: 0 auto;
            position: relative;
            z-index: 1
        }

        .page-badge {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            background: rgba(245,158,11,0.2);
            border: 1px solid rgba(245,158,11,0.4);
            color: var(--accent);
            padding: 6px 16px;
            border-radius: 50px;
            font-size: 12px;
            font-weight: 600;
            letter-spacing: .08em;
            text-transform: uppercase;
            margin-bottom: 24px
        }

        .page-hero h1 {
            font-family: 'Playfair Display', serif;
            font-size: clamp(36px, 5vw, 56px);
            color: #fff;
            font-weight: 700;
            line-height: 1.15;
            margin-bottom: 20px
        }

            .page-hero h1 em {
                font-style: normal;
                color: var(--accent)
            }

        .page-hero p {
            font-size: 17px;
            color: rgba(255,255,255,0.7);
            max-width: 600px;
            margin-bottom: 36px
        }

        .meta-row {
            display: flex;
            gap: 30px;
            flex-wrap: wrap
        }

        .meta-item {
            display: flex;
            align-items: center;
            gap: 8px;
            color: rgba(255,255,255,0.6);
            font-size: 13px
        }

            .meta-item .dot {
                width: 6px;
                height: 6px;
                background: var(--accent);
                border-radius: 50%
            }

        .content-wrapper {
            max-width: 1100px;
            margin: 0 auto;
            padding: 60px 60px 100px;
            display: grid;
            grid-template-columns: 260px 1fr;
            gap: 60px;
            align-items: start
        }

        .sidebar {
            position: sticky;
            top: 80px
        }

        .sidebar-card {
            background: #fff;
            border: 1px solid var(--border);
            border-radius: 16px;
            padding: 28px;
            box-shadow: 0 4px 24px rgba(5,150,105,0.06)
        }

        .sidebar-title {
            font-size: 11px;
            font-weight: 600;
            letter-spacing: .1em;
            text-transform: uppercase;
            color: var(--text-muted);
            margin-bottom: 16px
        }

        .toc-list {
            list-style: none;
            display: flex;
            flex-direction: column;
            gap: 4px
        }

            .toc-list a {
                text-decoration: none;
                color: var(--text-muted);
                font-size: 13.5px;
                padding: 7px 12px;
                border-radius: 8px;
                display: block;
                transition: all .2s;
                border-left: 2px solid transparent
            }

                .toc-list a:hover {
                    color: var(--primary);
                    background: var(--light-green);
                    border-left-color: var(--primary);
                    padding-left: 16px
                }

        .sidebar-support {
            margin-top: 20px;
            padding-top: 20px;
            border-top: 1px solid var(--border)
        }

            .sidebar-support p {
                font-size: 13px;
                color: var(--text-muted);
                margin-bottom: 12px
            }

        .support-btn {
            display: block;
            background: var(--light-green);
            color: var(--primary);
            text-decoration: none;
            text-align: center;
            padding: 10px;
            border-radius: 8px;
            font-size: 13px;
            font-weight: 600;
            transition: all .2s
        }

            .support-btn:hover {
                background: var(--primary);
                color: #fff
            }

        .main-content {
            min-width: 0
        }

        .intro-card {
            background: var(--gold-light);
            border: 1px solid rgba(245,158,11,0.3);
            border-radius: 16px;
            padding: 28px 32px;
            margin-bottom: 48px;
            display: flex;
            gap: 16px;
            align-items: flex-start
        }

        .intro-card-icon {
            font-size: 24px;
            flex-shrink: 0
        }

        .intro-card p {
            font-size: 15px;
            color: #78350F;
            line-height: 1.7
        }

            .intro-card p strong {
                color: #92400E
            }

        section.policy-section {
            margin-bottom: 56px;
            scroll-margin-top: 100px
        }

        .section-number {
            font-size: 12px;
            font-weight: 600;
            color: var(--primary);
            text-transform: uppercase;
            letter-spacing: .1em;
            margin-bottom: 8px
        }

        .policy-section h2 {
            font-family: 'Playfair Display', serif;
            font-size: 26px;
            font-weight: 700;
            color: var(--dark);
            margin-bottom: 20px;
            padding-bottom: 16px;
            border-bottom: 2px solid var(--border)
        }

        .policy-section p {
            font-size: 15.5px;
            color: #374151;
            margin-bottom: 16px;
            line-height: 1.85
        }

        .policy-section h3 {
            font-family: 'Playfair Display', serif;
            font-size: 18px;
            color: var(--dark);
            margin: 28px 0 12px;
            font-weight: 600
        }

        .data-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 16px;
            margin: 20px 0
        }

        .data-card {
            background: #fff;
            border: 1px solid var(--border);
            border-radius: 12px;
            padding: 20px;
            border-top: 3px solid var(--primary)
        }

            .data-card h4 {
                font-size: 14px;
                font-weight: 600;
                color: var(--dark);
                margin-bottom: 10px
            }

            .data-card ul {
                list-style: none;
                font-size: 13.5px;
                color: var(--text-muted);
                line-height: 1.9
            }

                .data-card ul li::before {
                    content: '›';
                    color: var(--primary);
                    font-weight: 700;
                    margin-right: 6px
                }

        .highlight-box {
            background: var(--light-green);
            border-left: 4px solid var(--primary);
            border-radius: 0 12px 12px 0;
            padding: 20px 24px;
            margin: 24px 0;
            font-size: 15px;
            color: #065F46
        }

        .info-box {
            background: #EFF6FF;
            border-left: 4px solid #3B82F6;
            border-radius: 0 12px 12px 0;
            padding: 20px 24px;
            margin: 24px 0;
            font-size: 15px;
            color: #1E3A5F
        }

        .gold-box {
            background: var(--gold-light);
            border-left: 4px solid var(--accent);
            border-radius: 0 12px 12px 0;
            padding: 20px 24px;
            margin: 24px 0;
            font-size: 15px;
            color: #78350F
        }

        .rights-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 14px;
            margin: 20px 0
        }

        .right-item {
            background: #fff;
            border: 1px solid var(--border);
            border-radius: 12px;
            padding: 18px;
            text-align: center
        }

            .right-item .right-icon {
                font-size: 24px;
                margin-bottom: 8px
            }

            .right-item h4 {
                font-size: 13px;
                font-weight: 600;
                color: var(--dark);
                margin-bottom: 4px
            }

            .right-item p {
                font-size: 12px;
                color: var(--text-muted);
                line-height: 1.5;
                margin: 0
            }

        .jurisdiction-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 16px;
            margin: 20px 0
        }

        .jurisdiction-card {
            background: #fff;
            border: 1px solid var(--border);
            border-radius: 12px;
            padding: 22px;
        }

            .jurisdiction-card.eu {
                border-top: 3px solid #3B82F6
            }

            .jurisdiction-card.ca {
                border-top: 3px solid #F59E0B
            }

            .jurisdiction-card h4 {
                font-size: 14px;
                font-weight: 700;
                color: var(--dark);
                margin-bottom: 10px;
                display: flex;
                align-items: center;
                gap: 8px
            }

            .jurisdiction-card p {
                font-size: 13.5px;
                color: var(--text-muted);
                line-height: 1.75;
                margin-bottom: 8px
            }

                .jurisdiction-card p:last-child {
                    margin-bottom: 0
                }

        .contact-card {
            background: linear-gradient(135deg, var(--dark), #065F46);
            border-radius: 16px;
            padding: 36px;
            color: #fff;
            margin-top: 20px
        }

            .contact-card h3 {
                font-family: 'Playfair Display', serif;
                font-size: 22px;
                margin-bottom: 12px;
                color: #fff
            }

            .contact-card p {
                color: rgba(255,255,255,0.7);
                font-size: 15px;
                margin-bottom: 20px
            }

        .contact-methods {
            display: flex;
            gap: 16px;
            flex-wrap: wrap
        }

        .contact-method {
            background: rgba(255,255,255,0.1);
            border: 1px solid rgba(255,255,255,0.2);
            border-radius: 10px;
            padding: 12px 18px;
            font-size: 14px;
            color: #fff;
            display: flex;
            align-items: center;
            gap: 8px
        }

            .contact-method span {
                color: var(--accent)
            }

        footer {
            background: var(--dark);
            padding: 40px 60px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            flex-wrap: wrap;
            gap: 20px
        }

            footer p {
                color: rgba(255,255,255,0.5);
                font-size: 13px
            }

        .footer-links {
            display: flex;
            gap: 24px
        }

            .footer-links a {
                color: rgba(255,255,255,0.5);
                text-decoration: none;
                font-size: 13px;
                transition: color .2s
            }

                .footer-links a:hover {
                    color: var(--accent)
                }

                .footer-links a.active-page {
                    color: var(--accent);
                    font-weight: 500
                }

        @@keyframes fadeUp {
            from {
                opacity: 0;
                transform: translateY(20px)
            }

            to {
                opacity: 1;
                transform: translateY(0)
            }
        }

        .hero-inner > * {
            animation: fadeUp .6s ease forwards;
            opacity: 0
        }

            .hero-inner > *:nth-child(1) {
                animation-delay: .1s
            }

            .hero-inner > *:nth-child(2) {
                animation-delay: .2s
            }

            .hero-inner > *:nth-child(3) {
                animation-delay: .3s
            }

            .hero-inner > *:nth-child(4) {
                animation-delay: .4s
            }

        @@media (max-width: 900px) {
            .content-wrapper {
                grid-template-columns: 1fr;
                padding: 40px 24px 80px
            }

            .sidebar {
                position: static
            }

            nav {
                padding: 16px 24px
            }

            .nav-links {
                display: none
            }

            .page-hero {
                padding: 60px 24px 80px
            }

            .data-grid, .rights-grid, .jurisdiction-grid {
                grid-template-columns: 1fr
            }

            footer {
                padding: 30px 24px
            }
        }
    </style>


    <div class="topbar">
        🔒 Your data is handled with care — Scoutix is committed to your privacy
    </div>

 

    <div class="page-hero">
        <div class="hero-inner">
            <div class="page-badge">🔒 Privacy &amp; Data</div>
            <h1>Privacy <em>Policy</em></h1>
            <p>Scoutix is built on trust. This policy explains exactly what data we collect, how we use it, and the rights you have — wherever you are in the world.</p>
            <div class="meta-row">
            <div class="meta-item"><div class="dot"></div> Effective Date: March 18, 2026</div>
            <div class="meta-item"><div class="dot"></div> Last Updated: March 18, 2026</div>
                <div class="meta-item"><div class="dot"></div> Operated by Muhammad Mohsin Shabbir · Islamabad, Pakistan</div>
            </div>
        </div>
    </div>

    <div class="content-wrapper">
        <aside class="sidebar">
            <div class="sidebar-card">
                <div class="sidebar-title">On this page</div>
