<!-- FAQ Section -->
<section class="faq-section">
    <div class="container">
        <div class="section-header text-center">
            <span class="section-badge">FAQ</span>
            <h2 class="section-title">Frequently asked questions</h2>
        </div>

        <div class="row justify-content-center">
            <div class="col-lg-8">
                <div class="faq-item">
                    <h5 class="faq-question">What data do I get for each lead?</h5>
                    <p class="faq-answer">You'll get business name, phone number, website URL, and full address for each lead sourced from publicly available business data online.</p>
                </div>

                <div class="faq-item">
                    <h5 class="faq-question">How fast is the lead generation process?</h5>
                    <p class="faq-answer">Lead generation starts instantly. Depending on your plan, you can collect 50-500 leads per search in minutes.</p>
                </div>

                <div class="faq-item">
                    <h5 class="faq-question">What happens if I don't use all my monthly leads?</h5>
                    <p class="faq-answer">Unused leads expire at the end of each month. Your quota resets on your billing date.</p>
                </div>

                <div class="faq-item">
                    <h5 class="faq-question">Can I cancel my subscription anytime?</h5>
                    <p class="faq-answer">Yes! You can cancel from the billing portal at any time. No long-term contracts or cancellation fees.</p>
                </div>

                <div class="faq-item">
                    <h5 class="faq-question">Do you offer refunds?</h5>
                    <p class="faq-answer">Yes — we offer a 30-day money-back guarantee for first-time subscribers. If you're not satisfied for any reason, email support@scoutix.io with the subject "Refund Request" within 30 days of your purchase and we'll refund you in full, no questions asked.</p>
                </div>

                <div class="faq-item">
                    <h5 class="faq-question">Is the data collection legal?</h5>
                    <p class="faq-answer">Scoutix sources publicly available business data from across the web. However, users are responsible for ensuring their use of the service complies with all applicable laws and regulations in their jurisdiction. Please review our Terms of Service for full details.</p>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Contact Section -->
<section id="contact" class="contact-section">
    <div class="container">
        <div class="section-header text-center">
            <span class="section-badge">CONTACT</span>
            <h2 class="section-title">Get in touch with us</h2>
            <p class="section-description">
                Have questions? We'd love to hear from you. Send us a message and we'll respond as soon as possible.
            </p>
        </div>

        <div class="row justify-content-center">
            <div class="col-lg-8">
                <div class="contact-form-wrapper">
                    <form id="contactForm" class="contact-form">
                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label for="name" class="form-label">Full Name</label>
                                    <input type="text" id="name" name="name" class="form-control" placeholder="John Doe" required>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label for="email" class="form-label">Email Address</label>
                                    <input type="email" id="email" name="email" class="form-control" placeholder="john@example.com" required>
                                </div>
                            </div>
                        </div>

                        <div class="form-group">
                            <label for="subject" class="form-label">Subject</label>
                            <input type="text" id="subject" name="subject" class="form-control" placeholder="How can we help?" required>
                        </div>

                        <div class="form-group">
                            <label for="message" class="form-label">Message</label>
                            <textarea id="message" name="message" class="form-control" rows="6" placeholder="Tell us more about your inquiry..." required></textarea>
                        </div>

                        <button type="submit" class="btn-contact-submit">
                            <i class="bi bi-send-fill me-2"></i>
                            Send Message
                        </button>
                    </form>

                    <div id="formSuccess" class="contact-success" style="display: none;">
                        <i class="bi bi-check-circle-fill"></i>
