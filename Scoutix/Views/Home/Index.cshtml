            </div>
            <div class="col-lg-4">
                <div class="step-card">
                    <div class="step-number">03</div>
                    <h4 class="step-title">Manage & Close</h4>
                    <p class="step-description">
                        Track every prospect in the built-in CRM — add notes, set follow-up dates, update statuses, and move deals forward without switching tools.
                    </p>
                </div>
            </div>
        </div>
    </div>
</section>

