@{
    Layout = "_VisitorLayout";
}

@section Styles {
    @* FAQPage structured data — mirrors the FAQ section below.
       Lets AI assistants (ChatGPT, Claude, Perplexity, Gemini) and Google
       answer questions about Scoutix using the company's own answers. *@
    <script type="application/ld+json">
    {
      "@@context": "https://schema.org",
      "@@type": "FAQPage",
      "mainEntity": [
        {
          "@@type": "Question",
          "name": "What data do I get for each lead?",
          "acceptedAnswer": {
            "@@type": "Answer",
            "text": "You'll get business name, phone number, website URL, and full address for each lead sourced from publicly available business data online."
          }
        },
        {
          "@@type": "Question",
          "name": "How fast is the lead generation process?",
          "acceptedAnswer": {
            "@@type": "Answer",
            "text": "Lead generation starts instantly. Depending on your plan, you can collect 50-500 leads per search in minutes."
          }
        },
        {
          "@@type": "Question",
          "name": "What happens if I don't use all my monthly leads?",
          "acceptedAnswer": {
            "@@type": "Answer",
            "text": "Unused leads expire at the end of each month. Your quota resets on your billing date."
          }
        },
        {
          "@@type": "Question",
          "name": "Can I cancel my subscription anytime?",
          "acceptedAnswer": {
            "@@type": "Answer",
            "text": "Yes! You can cancel from the billing portal at any time. No long-term contracts or cancellation fees."
          }
        },
        {
          "@@type": "Question",
          "name": "Do you offer refunds?",
          "acceptedAnswer": {
            "@@type": "Answer",
            "text": "Yes — we offer a 30-day money-back guarantee for first-time subscribers. If you're not satisfied for any reason, email support@@scoutix.io with the subject 'Refund Request' within 30 days of your purchase and we'll refund you in full, no questions asked."
          }
        },
        {
          "@@type": "Question",
          "name": "Is the data collection legal?",
          "acceptedAnswer": {
            "@@type": "Answer",
            "text": "Scoutix sources publicly available business data from across the web. However, users are responsible for ensuring their use of the service complies with all applicable laws and regulations in their jurisdiction. Please review our Terms of Service for full details."
          }
        }
      ]
    }
    </script>
}

