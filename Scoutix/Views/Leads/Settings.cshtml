@{
    ViewData["Title"] = "Settings";
    Layout = "_UserLayout";
}

@{
    var status = (ViewBag.SubscriptionStatus as string ?? "").ToLower();
    string statusLabel = status switch
    {
        "active" => "Active",
        "canceled" => "Canceled",
        "paused" => "Paused",
        "past_due" => "Past Due",
        _ => "Unknown"
    };
    string statusClass = status switch
    {
        "active" => "status-active",
        "paused" => "status-paused",
        "past_due" => "status-pastdue",
        _ => "status-canceled"
    };

    // Plan hierarchy
    var currentPlanName = (ViewBag.PlanName as string ?? "").ToLower().Trim();
    int planLevel = currentPlanName switch
    {
        "starter" => 1,
        "growth" => 2,
        "pro" => 3,
        _ => 0
    };

    bool canUpgrade = status == "active" && planLevel > 0 && planLevel < 3;
    bool canDowngrade = status == "active" && planLevel > 1;

    bool showGrowthUpgrade = planLevel == 1;
    bool showProUpgrade = planLevel == 1 || planLevel == 2;
    bool showGrowthDowngrade = planLevel == 3;
    bool showStarterDowngrade = planLevel == 2;
}

<!-- Settings Page -->
<section class="settings-section">
    <div class="container">

        <!-- Page Header -->
        <div class="settings-page-header">
            <div>
                <h1 class="settings-page-title">Billing &amp; Settings</h1>
                <p class="settings-page-subtitle">Manage your subscription and account preferences</p>
            </div>
            <div class="settings-page-badge">
                <i class="bi bi-gem me-1"></i> Scoutix
            </div>
        </div>

        <div class="row g-4">

            <!-- ══════════════════════════════════════
                 LEFT COLUMN — Billing Card
            ══════════════════════════════════════ -->
            <div class="col-lg-6">
                <div class="settings-card h-100">

                    <div class="settings-card-header">
                        <div class="settings-card-icon">
                            <i class="bi bi-credit-card-2-front-fill"></i>
                        </div>
                        <div>
                            <h3 class="settings-card-title">Billing</h3>
                            <p class="settings-card-subtitle">Your current plan &amp; subscription</p>
                        </div>
                    </div>

                    <!-- Plan Name + Status -->
                    <div class="billing-plan-box">
                        <div class="billing-plan-top">
                            <div>
                                <span class="billing-plan-label">Current Plan</span>
                                <span class="billing-plan-name">@ViewBag.PlanName</span>
                            </div>
                            <span class="subscription-status-badge @statusClass">
                                @if (status == "active")
                                {
                                    <i class="bi bi-circle-fill"></i>
                                }
                                @if (status == "paused")
                                {
                                    <i class="bi bi-pause-circle-fill"></i>
                                }
                                @if (status == "past_due")
                                {
                                    <i class="bi bi-exclamation-circle-fill"></i>
                                }
                                @if (status == "canceled")
                                {
                                    <i class="bi bi-x-circle-fill"></i>
                                }
                                @statusLabel
                            </span>
                        </div>
                        <div class="billing-price-row">
                            <span class="billing-price">@ViewBag.PlanPrice</span>
                            <span class="billing-price-period">/ month</span>
                        </div>
                    </div>

                    <!-- Billing Details -->
                    <div class="billing-details">
                        <div class="billing-detail-row">
                            <span class="billing-detail-label">
                                <i class="bi bi-calendar2-check-fill"></i> Start Date
                            </span>
                            <span class="billing-detail-value">@ViewBag.StartDate</span>
                        </div>
                        <div class="billing-detail-row">
                            <span class="billing-detail-label">
                                @if (status == "canceled")
                                {
                                    <i class="bi bi-calendar2-event-fill"></i>
                                    @: Access Ends
                                }
                                else
                                {
                                    <i class="bi bi-calendar2-x-fill"></i>
                                    @: Next Billing
                                }
                            </span>
                            <span class="billing-detail-value">@ViewBag.EndDate</span>
                        </div>
                    </div>

                    @if (status == "past_due")
                    {
                        <div class="billing-alert-banner">
                            <i class="bi bi-exclamation-triangle-fill"></i>
                            Your last payment failed. Please update your payment method to avoid losing access.
                        </div>
                    }

                    <!-- ══ UPGRADE / DOWNGRADE ══ -->
                    @if (canUpgrade || canDowngrade)
                    {
                        <div class="plan-change-section">
                            <p class="plan-change-label">
                                <i class="bi bi-arrow-left-right"></i> Change Plan
                            </p>

                            @if (showProUpgrade)
                            {
                                <button type="button"
                                        class="btn-plan-upgrade"
                                        data-plan="Pro"
                                        data-price="$149"
                                        data-bs-toggle="modal"
                                        data-bs-target="#planChangeModal">
                                    <div class="plan-upgrade-left">
                                        <span class="upgrade-pill">
                                            <i class="bi bi-arrow-up-circle-fill"></i> Upgrade
                                        </span>
                                        <span class="plan-upgrade-name">Pro Plan</span>
                                    </div>
                                    <div class="plan-upgrade-right">
                                        <span class="plan-upgrade-price">$149<small>/mo</small></span>
                                        <i class="bi bi-chevron-right"></i>
                                    </div>
                                </button>
                            }

                            @if (showGrowthUpgrade)
                            {
                                <button type="button"
                                        class="btn-plan-upgrade btn-plan-upgrade-secondary"
                                        data-plan="Growth"
                                        data-price="$69"
                                        data-bs-toggle="modal"
                                        data-bs-target="#planChangeModal">
                                    <div class="plan-upgrade-left">
                                        <span class="upgrade-pill">
                                            <i class="bi bi-arrow-up-circle-fill"></i> Upgrade
                                        </span>
                                        <span class="plan-upgrade-name">Growth Plan</span>
                                    </div>
                                    <div class="plan-upgrade-right">
                                        <span class="plan-upgrade-price">$69<small>/mo</small></span>
                                        <i class="bi bi-chevron-right"></i>
                                    </div>
                                </button>
                            }

                            @if (showGrowthDowngrade)
                            {
                                <button type="button"
                                        class="btn-plan-downgrade"
                                        data-plan="Growth"
                                        data-price="$69"
                                        data-bs-toggle="modal"
                                        data-bs-target="#planChangeModal">
                                    Switch to Growth ($69/mo) <i class="bi bi-arrow-down-short"></i>
                                </button>
                            }

                            @if (showStarterDowngrade)
                            {
                                <button type="button"
                                        class="btn-plan-downgrade"
                                        data-plan="Starter"
                                        data-price="$39"
                                        data-bs-toggle="modal"
                                        data-bs-target="#planChangeModal">
                                    Switch to Starter ($39/mo) <i class="bi bi-arrow-down-short"></i>
                                </button>
                            }
                        </div>
                    }
                    <!-- Action Buttons -->
                    <div class="billing-actions">
                        @if (status == "canceled")
                        {
                            <a href="/Account/ChoosePlan" class="btn-settings-primary">
                                <i class="bi bi-arrow-repeat me-2"></i>
                                Resubscribe
                            </a>
                        }
                        else
                        {
                            <form method="post" action="/Leads/BillingPortal">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn-settings-secondary">
                                    <i class="bi bi-box-arrow-up-right me-2"></i>
                                    Manage Billing
                                </button>
                            </form>
                        }
                    </div>

                    <p class="billing-portal-note">
                        <i class="bi bi-info-circle me-1"></i>
                        The billing portal lets you update your payment method, view invoices, or cancel your subscription.
                    </p>

                </div>
            </div>

            <!-- ══════════════════════════════════════
                 RIGHT COLUMN — Account Settings Card
            ══════════════════════════════════════ -->
            <div class="col-lg-6">
                <div class="settings-card h-100 d-flex flex-column">

                    <div class="settings-card-header">
                        <div class="settings-card-icon icon-gold">
                            <i class="bi bi-person-gear"></i>
                        </div>
                        <div>
                            <h3 class="settings-card-title">Account Settings</h3>
                            <p class="settings-card-subtitle">Profile info &amp; security</p>
                        </div>
                    </div>

                    <!-- Profile Info (read-only) -->
                    <div class="account-profile-box">
                        <div class="account-avatar">
                            @{
                                var initials = "";
                                var fullName = ViewBag.UserName as string ?? "";
                                var parts = fullName.Split(' ');
                                if (parts.Length >= 2)
                                    initials = $"{parts[0][0]}{parts[1][0]}".ToUpper();
                                else if (fullName.Length > 0)
                                    initials = fullName[0].ToString().ToUpper();
                                else
                                    initials = "U";
                            }
                            @initials
                        </div>
                        <div>
                            <div class="account-profile-name">@ViewBag.UserName</div>
                            <div class="account-profile-email">@ViewBag.UserEmail</div>
                        </div>
                    </div>

                    <!-- Change Password -->
                    <div class="settings-section-label">
                        <i class="bi bi-lock-fill"></i> Change Password
                    </div>

                    <form id="changePasswordForm" method="post" action="/Account/ChangePassword" autocomplete="off">
                        @Html.AntiForgeryToken()

                        <div class="form-group mb-3">
                            <label class="form-label">Current Password</label>
                            <div class="input-with-icon">
                                <i class="bi bi-lock-fill"></i>
                                <input type="password" name="CurrentPassword" id="CurrentPassword"
                                       class="form-control" placeholder="Enter current password" required autocomplete="off">
                                <button type="button" class="toggle-password" data-target="CurrentPassword">
                                    <i class="bi bi-eye-fill"></i>
                                </button>
                            </div>
                        </div>

                        <div class="form-group mb-3">
                            <label class="form-label">New Password</label>
                            <div class="input-with-icon">
                                <i class="bi bi-key-fill"></i>
                                <input type="password" name="NewPassword" id="NewPassword"
                                       class="form-control" placeholder="Min. 8 characters" required autocomplete="off">
                                <button type="button" class="toggle-password" data-target="NewPassword">
                                    <i class="bi bi-eye-fill"></i>
                                </button>
                            </div>
                        </div>

                        <div class="form-group mb-4">
                            <label class="form-label">Confirm New Password</label>
                            <div class="input-with-icon">
                                <i class="bi bi-key-fill"></i>
                                <input type="password" name="ConfirmNewPassword" id="ConfirmNewPassword"
                                       class="form-control" placeholder="Re-enter new password" required autocomplete="off">
                                <button type="button" class="toggle-password" data-target="ConfirmNewPassword">
                                    <i class="bi bi-eye-fill"></i>
                                </button>
                            </div>
                        </div>

                        <button type="submit" class="btn-settings-primary w-100">
                            <i class="bi bi-shield-check me-2"></i>
                            Save New Password
                        </button>
                    </form>

                    <!-- Danger Zone -->
                    <div class="danger-zone mt-auto">
                        <div class="danger-zone-header">
                            <i class="bi bi-exclamation-triangle-fill"></i>
                            Danger Zone
                        </div>
                        <p class="danger-zone-text">
                            Permanently deletes your account, all data, and cancels your subscription.
                            <strong>This action cannot be undone.</strong>
                        </p>
                        <button type="button" class="btn-settings-danger" id="openDeleteModal">
                            <i class="bi bi-trash3-fill me-2"></i>
                            Delete My Account
                        </button>
                    </div>

                </div>
            </div>

        </div><!-- /row -->
    </div><!-- /container -->
</section>

<!-- ══════════════════════════════════════
     Plan Change Confirmation Modal
══════════════════════════════════════ -->
<div class="modal fade" id="planChangeModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content settings-modal">
            <div class="modal-header settings-modal-header" id="planModalHeader">
                <div class="modal-plan-icon" id="planModalIcon">
                    <i class="bi bi-arrow-up-circle-fill" id="planModalIconGlyph"></i>
                </div>
            </div>
            <div class="modal-body settings-modal-body">
                <h4 class="modal-title" id="planModalTitle">Upgrade Your Plan</h4>
                <p class="modal-description">
                    You are about to switch to the <strong id="planModalPlanName"></strong> plan
                    at <strong id="planModalPrice"></strong>/month.
                    The change takes effect immediately and billing is prorated.
                </p>
                <div class="modal-plan-info-box" id="planModalInfoBox">
                    <i class="bi bi-info-circle-fill" id="planModalInfoIcon"></i>
                    <span id="planModalInfoText"></span>
                </div>
            </div>
            <div class="modal-footer settings-modal-footer">
                <button type="button" class="btn-modal-cancel" data-bs-dismiss="modal">Cancel</button>
                <form method="post" action="/Leads/ChangePlan" id="planChangeForm">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="NewPlanName" id="planChangeInput" value="" />
                    <button type="submit" class="btn-modal-confirm" id="planModalConfirmBtn">
                        <i class="bi bi-arrow-up-circle-fill me-2" id="planModalConfirmIcon"></i>
                        <span id="planModalConfirmText">Upgrade Now</span>
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- ══════════════════════════════════════
     Delete Account Confirmation Modal
══════════════════════════════════════ -->
<div class="modal fade" id="deleteAccountModal" tabindex="-1" aria-labelledby="deleteModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content settings-modal">
            <div class="modal-header settings-modal-header danger-header">
                <div class="modal-danger-icon">
                    <i class="bi bi-trash3-fill"></i>
                </div>
            </div>
            <div class="modal-body settings-modal-body">
                <h4 class="modal-title" id="deleteModalLabel">Delete Your Account?</h4>
                <p class="modal-description">
                    This will <strong>permanently delete</strong> your Scoutix account, all your data,
                    leads, CRM records, and cancel your subscription. You will lose access immediately.
                </p>
                <div class="modal-warning-box">
                    <i class="bi bi-exclamation-circle-fill"></i>
                    This action is <strong>irreversible</strong> and cannot be undone.
                </div>
                <p class="modal-confirm-prompt">Type <strong>DELETE</strong> to confirm:</p>
                <input type="text" id="deleteConfirmInput" class="form-control modal-confirm-input"
                       placeholder="Type DELETE here" autocomplete="off">
            </div>
            <div class="modal-footer settings-modal-footer">
                <button type="button" class="btn-modal-cancel" data-bs-dismiss="modal">Cancel</button>
                <form method="post" action="/Account/DeleteAccount" id="deleteAccountForm">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn-modal-danger" id="confirmDeleteBtn" disabled>
                        <i class="bi bi-trash3-fill me-2"></i>
                        Yes, Delete My Account
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

<style>
    /* ── Layout ── */
    .btn-plan-upgrade-secondary {
        background: linear-gradient(135deg, #047857, #065F46);
        box-shadow: 0 4px 16px rgba(5,150,105,0.14);
        opacity: 0.88;
    }

        .btn-plan-upgrade-secondary:hover {
            opacity: 1;
        }

    .settings-section {
        padding: 2.5rem 0 4rem;
        background: linear-gradient(135deg, #F0FDF4 0%, #D1FAE5 100%);
        min-height: calc(100vh - 80px);
    }

    .settings-page-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        margin-bottom: 2rem;
        flex-wrap: wrap;
        gap: 1rem;
    }

    .settings-page-title {
        font-size: 1.85rem;
        font-weight: 800;
        color: #064E3B;
        margin: 0 0 0.25rem;
    }

    .settings-page-subtitle {
        font-size: 0.95rem;
        color: #6B7280;
        margin: 0;
    }

    .settings-page-badge {
        background: linear-gradient(135deg, #064E3B, #065F46);
        color: #FCD34D;
        font-size: 0.85rem;
        font-weight: 700;
        padding: 0.5rem 1.1rem;
        border-radius: 50px;
        display: flex;
        align-items: center;
    }

   

    @@keyframes slideDown {
        from {
            opacity: 0;
            transform: translateY(-12px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }      

    /* ── Card ── */
    .settings-card {
        background: white;
        border-radius: 20px;
        padding: 2rem;
        box-shadow: 0 8px 40px rgba(0,0,0,0.07);
        border: 1px solid rgba(5,150,105,0.1);
    }

    .settings-card-header {
        display: flex;
        align-items: center;
        gap: 1rem;
        margin-bottom: 1.75rem;
        padding-bottom: 1.25rem;
        border-bottom: 1.5px solid #F3F4F6;
    }

    .settings-card-icon {
        width: 52px;
        height: 52px;
        border-radius: 14px;
        background: linear-gradient(135deg, #059669, #047857);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.4rem;
        color: white;
        flex-shrink: 0;
    }

        .settings-card-icon.icon-gold {
            background: linear-gradient(135deg, #B7791F, #92400E);
        }

    .settings-card-title {
        font-size: 1.15rem;
        font-weight: 800;
        color: #1A1A1A;
        margin: 0 0 0.2rem;
    }

    .settings-card-subtitle {
        font-size: 0.85rem;
        color: #9CA3AF;
        margin: 0;
    }

    /* ── Billing Plan Box ── */
    .billing-plan-box {
        background: linear-gradient(135deg, #064E3B, #065F46);
        border-radius: 14px;
        padding: 1.4rem 1.5rem;
        margin-bottom: 1.25rem;
    }

    .billing-plan-top {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        margin-bottom: 0.875rem;
    }

    .billing-plan-label {
        display: block;
        font-size: 0.72rem;
        font-weight: 700;
        color: rgba(255,255,255,0.55);
        text-transform: uppercase;
        letter-spacing: 0.07em;
        margin-bottom: 0.25rem;
    }

    .billing-plan-name {
        font-size: 1.25rem;
        font-weight: 800;
        color: white;
    }

    .billing-price-row {
        display: flex;
        align-items: baseline;
        gap: 0.3rem;
    }

    .billing-price {
        font-size: 2rem;
        font-weight: 800;
        color: #FCD34D;
        line-height: 1;
    }

    .billing-price-period {
        font-size: 0.9rem;
        color: rgba(255,255,255,0.6);
    }

    /* ── Status Badge ── */
    .subscription-status-badge {
        display: inline-flex;
        align-items: center;
        gap: 0.35rem;
        padding: 0.3rem 0.8rem;
        border-radius: 50px;
        font-size: 0.78rem;
        font-weight: 700;
        flex-shrink: 0;
    }

        .subscription-status-badge i {
            font-size: 0.65rem;
        }

    .status-active {
        background: rgba(16,185,129,0.2);
        color: #6EE7B7;
    }

    .status-canceled {
        background: rgba(239,68,68,0.2);
        color: #FCA5A5;
    }

    .status-paused {
        background: rgba(245,158,11,0.2);
        color: #FCD34D;
    }

    .status-pastdue {
        background: rgba(239,68,68,0.25);
        color: #FCA5A5;
    }

    /* ── Billing Details ── */
    .billing-details {
        display: flex;
        flex-direction: column;
        gap: 0.6rem;
        margin-bottom: 1.25rem;
    }

    .billing-detail-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 0.65rem 0.875rem;
        background: #F9FAFB;
        border-radius: 10px;
    }

    .billing-detail-label {
        font-size: 0.875rem;
        color: #6B7280;
        font-weight: 500;
        display: flex;
        align-items: center;
        gap: 0.4rem;
    }

        .billing-detail-label i {
            color: #059669;
        }

    .billing-detail-value {
        font-size: 0.9rem;
        font-weight: 700;
        color: #1A1A1A;
    }

    /* ── Past Due Warning ── */
    .billing-alert-banner {
        background: #FEF3C7;
        border: 1.5px solid #FCD34D;
        color: #92400E;
        border-radius: 10px;
        padding: 0.875rem 1rem;
        font-size: 0.875rem;
        font-weight: 500;
        display: flex;
        align-items: flex-start;
        gap: 0.6rem;
        margin-bottom: 1.25rem;
    }

        .billing-alert-banner i {
            color: #D97706;
            font-size: 1rem;
            flex-shrink: 0;
            margin-top: 0.05rem;
        }

    /* ══ PLAN CHANGE SECTION ══ */
    .plan-change-section {
        background: #F9FAFB;
        border: 1px solid #E5E7EB;
        border-radius: 14px;
        padding: 1rem 1.1rem;
        margin-bottom: 1.25rem;
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
    }

    .plan-change-label {
        font-size: 0.72rem;
        font-weight: 700;
        color: #9CA3AF;
        text-transform: uppercase;
        letter-spacing: 0.07em;
        display: flex;
        align-items: center;
        gap: 0.35rem;
        margin: 0 0 0.25rem;
    }

    /* Upgrade — prominent green card */
    .btn-plan-upgrade {
        display: flex;
        justify-content: space-between;
        align-items: center;
        width: 100%;
        padding: 1rem 1.25rem;
        background: linear-gradient(135deg, #059669, #047857);
        border: none;
        border-radius: 12px;
        cursor: pointer;
        transition: transform 0.25s ease, box-shadow 0.25s ease;
        box-shadow: 0 4px 16px rgba(5,150,105,0.22);
    }

        .btn-plan-upgrade:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 26px rgba(5,150,105,0.35);
        }

    .plan-upgrade-left {
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        gap: 0.2rem;
    }

    .upgrade-pill {
        display: inline-flex;
        align-items: center;
        gap: 0.3rem;
        background: rgba(255,255,255,0.18);
        color: #A7F3D0;
        font-size: 0.68rem;
        font-weight: 700;
        padding: 0.18rem 0.6rem;
        border-radius: 50px;
        text-transform: uppercase;
        letter-spacing: 0.05em;
    }

    .plan-upgrade-name {
        font-size: 1rem;
        font-weight: 700;
        color: white;
    }

    .plan-upgrade-right {
        display: flex;
        align-items: center;
        gap: 0.4rem;
        color: rgba(255,255,255,0.5);
    }

    .plan-upgrade-price {
        font-size: 1.3rem;
        font-weight: 800;
        color: #FCD34D;
    }

        .plan-upgrade-price small {
            font-size: 0.72rem;
            color: rgba(255,255,255,0.55);
            font-weight: 500;
        }

    /* Downgrade — minimal text-link */
    .btn-plan-downgrade {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.2rem;
        width: 100%;
        padding: 0.4rem 0;
        background: none;
        border: none;
