<script>
    $(document).ready(function () {        
        /* ── Toggle password ── */
        $('.toggle-password').on('click', function () {
            var targetId = $(this).data('target');
            var $input   = $('#' + targetId);
            var $icon    = $(this).find('i');
            if ($input.attr('type') === 'password') {
                $input.attr('type', 'text');
                $icon.removeClass('bi-eye-fill').addClass('bi-eye-slash-fill');
            } else {
                $input.attr('type', 'password');
                $icon.removeClass('bi-eye-slash-fill').addClass('bi-eye-fill');
            }
        });

        /* ── Password match validation ── */
        $('#changePasswordForm').on('submit', function (e) {
            if ($('#NewPassword').val() !== $('#ConfirmNewPassword').val()) {
                e.preventDefault();
                iziToast.error({ title: 'Error', message: 'New passwords do not match.', position: 'topCenter', timeout: 3000 });
            }
        });

        /* ── Plan change modal — populate dynamically ── */
        $('#planChangeModal').on('show.bs.modal', function (e) {
            var $btn      = $(e.relatedTarget);
            var plan      = $btn.data('plan');
            var price     = $btn.data('price');
            var isUpgrade = $btn.hasClass('btn-plan-upgrade');

            $('#planChangeInput').val(plan);
            $('#planModalHeader').css('background', isUpgrade ? '#F0FDF4' : '#FAFAFA');

            $('#planModalIcon').removeClass('is-upgrade is-downgrade').addClass(isUpgrade ? 'is-upgrade' : 'is-downgrade');
            $('#planModalIconGlyph').removeClass('bi-arrow-up-circle-fill bi-arrow-down-circle-fill')
                .addClass(isUpgrade ? 'bi-arrow-up-circle-fill' : 'bi-arrow-down-circle-fill');

            $('#planModalTitle').text(isUpgrade ? 'Upgrade Your Plan' : 'Downgrade Your Plan');
            $('#planModalPlanName').text(plan);
            $('#planModalPrice').text(price);

            $('#planModalInfoBox').removeClass('is-upgrade is-downgrade').addClass(isUpgrade ? 'is-upgrade' : 'is-downgrade');
            $('#planModalInfoIcon').removeClass('bi-info-circle-fill bi-exclamation-circle-fill')
                .addClass(isUpgrade ? 'bi-info-circle-fill' : 'bi-exclamation-circle-fill');
            $('#planModalInfoText').text(isUpgrade
                ? 'You will get immediate access to all features in the new plan. Billing is prorated.'
                : 'You will lose access to higher-tier features at the end of this billing period.');

            $('#planModalConfirmBtn').removeClass('is-upgrade is-downgrade').addClass(isUpgrade ? 'is-upgrade' : 'is-downgrade');
            $('#planModalConfirmIcon').removeClass('bi-arrow-up-circle-fill bi-arrow-down-circle-fill')
                .addClass(isUpgrade ? 'bi-arrow-up-circle-fill' : 'bi-arrow-down-circle-fill');
            $('#planModalConfirmText').text(isUpgrade ? 'Upgrade Now' : 'Downgrade Plan');
        });

        /* ── Delete modal ── */
        $('#openDeleteModal').on('click', function () {
            $('#deleteConfirmInput').val('');
            $('#confirmDeleteBtn').prop('disabled', true);
            new bootstrap.Modal(document.getElementById('deleteAccountModal')).show();
        });

        $('#deleteConfirmInput').on('input', function () {
            $('#confirmDeleteBtn').prop('disabled', $(this).val().trim() !== 'DELETE');
        });

    });
</script>
